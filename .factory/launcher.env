# shellcheck shell=bash
# ─────────────────────────────────────────────────────────────────────
# Per-project launcher manifest, consumed by `omp-here`.
#
# Shell-sourced (POSIX + bash arrays). Declares which env vars this
# project needs before omp can safely run here. Real values live in
# `.env.local` (gitignored, not yet created for this repo — see
# `.env.example` for the full var reference); this file only
# enumerates what must be present.
#
# Keep this file free of secrets. It is committed.
# ─────────────────────────────────────────────────────────────────────

# Short project identifier used in launcher log output.
PROJECT_NAME="sesamo"

# Env vars that MUST be set (non-empty) after .env.local is sourced.
# Missing any of these → omp-here refuses to start in strict mode.
#
# SESAMO_DATABASE_URL: internal/config/config.go's Load() hard-fails
# (fmt.Errorf) if empty, and main.go calls db.Connect() immediately
# after — every subcommand (serve, migrate) needs it.
REQUIRED_ENV=(
  SESAMO_DATABASE_URL
)

# Env vars that are nice-to-have but not fatal. All of these carry a
# coded default (getenv/getbool/getint with a fallback in config.go)
# or are feature-gated — e.g. the Google/GitHub/Apple OAuth triplets
# only enable that provider when all of its own fields are set, and
# SESAMO_SERVICE_TOKEN / SESAMO_ADMIN_API_KEY just 503 their own
# endpoint when unset rather than blocking boot. Launcher warns if
# missing in strict mode, stays silent in --permissive.
OPTIONAL_ENV=(
  SESAMO_BASE_URL
  SESAMO_LISTEN_ADDR
  SESAMO_COOKIE_NAME
  SESAMO_COOKIE_SECURE
  SESAMO_COOKIE_DOMAIN
  SESAMO_SESSION_LIFETIME_DAYS
  SESAMO_ROLLING_RENEWAL_THRESHOLD_MINUTES
  SESAMO_SERVICE_TOKEN
  SESAMO_ADMIN_API_KEY
  SESAMO_TRUST_PROXY
  SESAMO_AUDIT_STRICT
  SESAMO_AUDIT_RETENTION_DAYS
  SESAMO_GOOGLE_CLIENT_ID
  SESAMO_GOOGLE_CLIENT_SECRET
  SESAMO_GOOGLE_REDIRECT_URI
  SESAMO_GITHUB_CLIENT_ID
  SESAMO_GITHUB_CLIENT_SECRET
  SESAMO_GITHUB_REDIRECT_URI
  SESAMO_APPLE_CLIENT_ID
  SESAMO_APPLE_TEAM_ID
  SESAMO_APPLE_KEY_ID
  SESAMO_APPLE_PRIVATE_KEY
  SESAMO_APPLE_REDIRECT_URI
  SESAMO_EMAIL_PROVIDER
  SESAMO_EMAIL_FROM
  SESAMO_EMAIL_API_KEY
  SESAMO_THEME_CSS_URL
  SESAMO_OIDC_ENABLED
  SESAMO_BRAND_LOGO_URL
  SESAMO_BRAND_PRIMARY_COLOR
  SESAMO_BRAND_PAGE_BG
  SESAMO_BRAND_FONT_URL
)

# No DERIVED_ENV entries for this project.
DERIVED_ENV=()

# No production DB to fingerprint yet (repo has no local .env.local).
EXPECTED_DB_HOST=""

# ── Environment ────────────────────────────────────────────────────
# "development" (default) or "production". Development keeps the
# permissive defaults below working out of the box. Production refuses
# to boot unless ALL of these hold — every violation is listed at once:
#   - SESAMO_BASE_URL starts with https://
#   - SESAMO_COOKIE_SECURE=true
#   - SESAMO_SERVICE_TOKEN and SESAMO_ADMIN_API_KEY are set, >= 32
#     characters, and different from each other
#   - SESAMO_EMAIL_PROVIDER is resend or postmark (never "log"),
#     SESAMO_EMAIL_API_KEY is set, SESAMO_EMAIL_FROM is a real address
#     (not localhost), and SESAMO_EMAIL_OUTBOX_KEYS is set (queued
#     email payloads embed bearer links and are encrypted at rest)
#   - each OAuth block (google/github/apple) is fully set or fully
#     empty — a half-configured provider is a boot failure, not a
#     silently missing login button. Apple additionally fails boot when
#     SESAMO_APPLE_PRIVATE_KEY is not a parseable PKCS#8 EC key.
#   - SESAMO_DATABASE_URL states sslmode=require|verify-ca|verify-full
#     (an absent sslmode means pgx would default to "prefer", which
#     falls back to plaintext)
#   - SESAMO_SESSION_LIFETIME_DAYS,
#     SESAMO_ROLLING_RENEWAL_THRESHOLD_MINUTES and
#     SESAMO_SESSION_MAX_LIFETIME_DAYS parse as integers > 0
# SESAMO_ENV=development

# ── Project identity ────────────────────────────────────────────────
# One Sésamo deployment serves one consuming project (docs/adr/0001).
# The slug and display name identify this deployment in the public
# descriptor (GET /.well-known/sesamo), `sesamo describe` and logs.
# They are NOT an authorization boundary. Slug: lowercase [a-z0-9-],
# 1-64 chars, no leading/trailing hyphen.
# SESAMO_PROJECT_SLUG=sesamo
# SESAMO_PROJECT_DISPLAY_NAME=Sésamo

# ── Core ───────────────────────────────────────────────────────────
# Postgres DSN. The docker-compose dev DB listens on 7432.
# Pool tuning goes here as pgx DSN params, e.g.
#   ...?sslmode=disable&pool_max_conns=10&pool_min_conns=2
# Defaults: max conns = max(4, NumCPU), conn lifetime 1h, idle 30m.
SESAMO_DATABASE_URL=postgres://sesamo:sesamo@localhost:7432/sesamo_dev?sslmode=disable
# Public base URL of this server (used for cookies + OAuth redirects).
SESAMO_BASE_URL=http://localhost:7777
# HTTP listen address.
SESAMO_LISTEN_ADDR=:7777

# ── Cookie / session ───────────────────────────────────────────────
SESAMO_COOKIE_NAME=sid
# false only for local http dev. true in production.
SESAMO_COOKIE_SECURE=false
# Set when Sésamo and the consuming app live on sibling subdomains and you
# want the sid cookie sent to both (e.g. ".example.com"). Leave empty for
# single-origin deployments (path-routed under one host) or for local dev.
SESAMO_COOKIE_DOMAIN=
SESAMO_SESSION_LIFETIME_DAYS=30
SESAMO_ROLLING_RENEWAL_THRESHOLD_MINUTES=15
# Absolute ceiling on a session's age, counted from creation. Rolling
# renewal extends expires_at up to this bound and never past it, so a
# stolen cookie kept warm by an attacker still dies here. Must be >=
# SESAMO_SESSION_LIFETIME_DAYS (checked at boot, both environments).
SESAMO_SESSION_MAX_LIFETIME_DAYS=90

# ── Service-to-service + admin tokens ──────────────────────────────
# Consumers (e.g. Acme) send this to call POST /v1/introspect.
SESAMO_SERVICE_TOKEN=dev-service-token-change-me
# Required for /v1/admin/* endpoints (user import, etc.).
SESAMO_ADMIN_API_KEY=dev-admin-key-change-me

# Honor X-Forwarded-For for client IPs (rate limiting, logs, audit log).
# Leave false unless Sésamo sits behind a trusted reverse proxy that
# OVERWRITES the header; a spoofable XFF would bypass per-IP rate limits.
SESAMO_TRUST_PROXY=false

# Strict audit mode: if the audit_log INSERT fails, the auth operation
# that would have been evidenced fails too (500) instead of proceeding.
# Default false = best-effort (a warning is logged, the operation runs).
# Enable for compliance-grade deployments where evidence is mandatory.
SESAMO_AUDIT_STRICT=false

# Audit log retention in days. 0 (default) keeps rows forever; when > 0
# the hourly maintenance job deletes audit_log rows older than N days.
# Pick a retention before production or the table grows unbounded.
SESAMO_AUDIT_RETENTION_DAYS=0

# ── Consuming-app redirects ─────────────────────────────────────────
# Comma-separated exact-match allowlist of external origins that
# redirect_to (login, OAuth, magic link) and logout redirect_to may
# target, e.g. "http://127.0.0.1:8010,https://app.example.com".
# Bare origins only — no path, query, fragment, userinfo, or wildcard.
# Empty (default): only internal paths are honored; everything else
# lands on "/".
SESAMO_REDIRECT_ORIGINS=

# Registration policy: "public" (default) or "disabled". With
# "disabled", POST /signup refuses with a stable 403 and OAuth login
# refuses to create a brand-new account (existing users, including
# identities linked by email, keep logging in). Provision accounts before
# switching to "disabled"; afterward new users require direct DB provisioning.
SESAMO_SIGNUP=public

# ── OAuth: Google ──────────────────────────────────────────────────
SESAMO_GOOGLE_CLIENT_ID=
SESAMO_GOOGLE_CLIENT_SECRET=
SESAMO_GOOGLE_REDIRECT_URI=http://localhost:7777/auth/google/callback

# ── OAuth: GitHub (optional) ───────────────────────────────────────
SESAMO_GITHUB_CLIENT_ID=
SESAMO_GITHUB_CLIENT_SECRET=
SESAMO_GITHUB_REDIRECT_URI=http://localhost:7777/auth/github/callback

# ── OAuth: Apple (optional) ────────────────────────────────────────
SESAMO_APPLE_CLIENT_ID=
SESAMO_APPLE_TEAM_ID=
SESAMO_APPLE_KEY_ID=
SESAMO_APPLE_PRIVATE_KEY=
SESAMO_APPLE_REDIRECT_URI=http://localhost:7777/auth/apple/callback

# ── Email (magic-link, reset, verify) ───────────────────────────────
# Provider: "log" (dev, prints link to stdout), "resend", or "postmark".
SESAMO_EMAIL_PROVIDER=log
SESAMO_EMAIL_FROM=auth@localhost
SESAMO_EMAIL_API_KEY=
# AES-256-GCM keyring for the transactional-email outbox. Queued
# payloads embed one-time bearer links, so they are encrypted at rest:
#   <active-id>:<base64 32 bytes>[,<old-id>:<base64 32 bytes>...]
# The FIRST key encrypts; the rest only decrypt (overlapped rotation:
# prepend a new key, deploy, drop the old one after the queue drains).
# Generate a key with: openssl rand -base64 32
# Empty in dev = an ephemeral boot-time key (queued mail does not
# survive a restart, which is fine for the stdout log provider).
# Required in production.
SESAMO_EMAIL_OUTBOX_KEYS=
# Svix signing secret ("whsec_...") from the Resend webhook dashboard.
# Enables POST /v1/webhooks/resend for delivery/bounce/complaint state.
# Empty disables the webhook endpoint (outbox stops at "accepted").
SESAMO_RESEND_WEBHOOK_SECRET=

# ── Theming ────────────────────────────────────────────────────────
# Optional URL to a CSS file that overrides --ses-* theme tokens.
SESAMO_THEME_CSS_URL=

# ── OIDC (V2, off in V1) ───────────────────────────────────────────
SESAMO_OIDC_ENABLED=false

# ── Branding (no-code, Auth0-style) ─────────────────────────────────
# All optional. Served as a generated /ui/brand.css layered between the
# base tokens and SESAMO_THEME_CSS_URL. Logo/font hosts are added to the
# CSP (img-src / font-src) exactly; values are validated at boot.
SESAMO_BRAND_LOGO_URL=
SESAMO_BRAND_PRIMARY_COLOR=
SESAMO_BRAND_PAGE_BG=
SESAMO_BRAND_FONT_URL=
